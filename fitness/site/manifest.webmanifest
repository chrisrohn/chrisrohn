{
  "id": "./",
  "name": "Training & Recovery",
  "short_name": "Training",
  "description": "Your day's call, readiness, sleep, season plan and a cycling computer: routes, turn by turn, climbs, maps and workouts. The data stays on your devices.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "./?source=app",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#f5f2ea",
  "theme_color": "#111111",
  "categories": ["health", "fitness", "sports", "navigation"],
  "prefer_related_applications": false,
  "launch_handler": { "client_mode": "navigate-existing" },
  "share_target": {
    "action": "./ride.html?share=1",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": { "files": [{ "name": "route", "accept": [".gpx", ".tcx", ".geojson", "application/gpx+xml", "application/vnd.garmin.tcx+xml", "application/geo+json", "application/xml", "text/xml", "application/octet-stream"] }] }
  },
  "file_handlers": [
    { "action": "./ride.html", "accept": { "application/gpx+xml": [".gpx"], "application/vnd.garmin.tcx+xml": [".tcx"], "application/geo+json": [".geojson"] } }
  ],
  "icons": [
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon-mono.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "monochrome" }
  ],
  "shortcuts": [
    { "name": "Ride mode", "short_name": "Ride", "description": "Live heart rate, today's session as timed steps", "url": "./ride.html?source=shortcut", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Ride a route", "short_name": "Route", "description": "The map, turn by turn, and the climbs ahead", "url": "./ride.html?source=shortcut&page=map", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Today", "description": "Today's call", "url": "./?source=shortcut#today", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "This week", "short_name": "Week", "description": "The next 7 days and race day", "url": "./?source=shortcut#plan", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
