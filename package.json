{
  "name": "chrisrohn-new-music-site",
  "private": true,
  "type": "module",
  "description": "The chrisrohn.com client (site/src) with its build, lint, type check, browser smoke test and installable-app screenshots",
  "scripts": {
    "build": "node build.mjs",
    "lint": "eslint && npm run lint:html",
    "lint:html": "html-validate site/*.html",
    "typecheck": "tsc -p tsconfig.json",
    "check": "npm run lint && npm run typecheck && npm run build",
    "test": "playwright test",
    "lighthouse": "npm run build && lhci autorun",
    "serve": "npm run build && python3 -m http.server -d dist 8000",
    "screenshots": "npm run build && node screenshots.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "html-validate": "^11.15.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
