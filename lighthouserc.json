{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "url": ["http://localhost/index.html", "http://localhost/privacy.html"],
      "numberOfRuns": 2,
      "settings": { "chromeFlags": "--no-sandbox --headless=new", "skipAudits": ["uses-http2", "uses-text-compression", "uses-long-cache-ttl", "cache-insight"] }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.8, "aggregationMethod": "median-run" }],
        "categories:accessibility": ["error", { "minScore": 0.95, "aggregationMethod": "median-run" }],
        "categories:best-practices": ["error", { "minScore": 0.9, "aggregationMethod": "median-run" }],
        "categories:seo": ["error", { "minScore": 0.9, "aggregationMethod": "median-run" }],
        "errors-in-console": "warn",
        "is-crawlable": "error",
        "installable-manifest": "off"
      }
    },
    "upload": { "target": "filesystem", "outputDir": "./lighthouse-report" }
  }
}
